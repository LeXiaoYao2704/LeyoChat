# Keep repository text deterministic across Windows and Unix checkouts.
* text=auto eol=lf

# Windows-native scripts and installer resources.
*.bat text eol=crlf
*.cmd text eol=crlf
*.iss text eol=crlf
*.iss.in text eol=crlf
*.isl text eol=crlf
*.manifest text eol=crlf
*.ps1 text eol=crlf
*.rc text eol=crlf
*.rc.in text eol=crlf

# Binary assets.
*.bmp binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.png binary
*.ttf binary
*.wav binary

# Preserve vendored formatting without applying project whitespace policy.
third_party/** -whitespace
windows/ChineseSimplified.isl -whitespace
